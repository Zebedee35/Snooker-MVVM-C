    "tip_jar.body" : {
      "comment" : "Main text on the tipping screen, written by the developer in the first person. Keep it warm and personal rather than formal. Keep the emoji.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hundreds of hours of work, heart and passion went into this app — built to make following snooker simpler and more enjoyable. There are no paid features: everything stays free. If it brought you a little joy, a small optional tip helps me keep improving it. Thank you! 🙏"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamaya yüzlerce saatlik emek, sevgi ve tutku girdi — snooker takip etmeyi daha basit ve keyifli hale getirmek için. Ücretli özellik yok: her şey ücretsiz kalıyor. Size küçük bir mutluluk kattıysa, isteğe bağlı ufak bir destek onu geliştirmeye devam etmemi sağlar. Teşekkürler! 🙏"
          }
        }
      }
    },
    "tip_jar.empty" : {
      "comment" : "Shown when no tipping options could be loaded.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No options available right now."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda seçenek yok."
          }
        }
      }
    },
    "tip_jar.error_title" : {
      "comment" : "Alert title when a purchase fails.",
      "extractionState" : "manual",
