    "tip_jar.footer_monthly" : {
      "comment" : "Legally required subscription disclosure. Apple reviews this text, so keep every fact: auto-renewal, the 1 month term, charging to the Apple Account, and how to cancel.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly Support is an auto-renewable subscription. Each plan lasts 1 month and renews automatically at the price shown until cancelled. Payment is charged to your Apple Account; you can cancel anytime in your App Store subscription settings. No features are unlocked — this is purely optional support."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aylık Destek, otomatik yenilenen bir aboneliktir. Her plan 1 ay sürer ve iptal edilene kadar gösterilen fiyattan otomatik olarak yenilenir. Ödeme Apple Hesabınızdan tahsil edilir; App Store abonelik ayarlarınızdan istediğiniz zaman iptal edebilirsiniz. Hiçbir özellik açılmaz — bu tamamen isteğe bağlı bir destektir."
          }
        }
      }
    },
    "tip_jar.footer_one_time" : {
      "comment" : "Disclosure under the one-time tip options.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A one-time tip. No subscription, no features unlocked — just a thank-you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek seferlik bir destek. Abonelik yok, açılan özellik yok — sadece bir teşekkür."
          }
        }
      }
    },
